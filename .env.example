# ── AutoRecruit AI — Docker environment ──────────────────────────────────────
# Copy this file to .env and fill in the values before running docker-compose up

# Auth.js — CHANGE THIS before going to production
NEXTAUTH_SECRET=super-secret-autorecruit-key-32-chars-long-abc12345
NEXTAUTH_URL=http://localhost:3000

# Platform admin seed account
PLATFORM_ADMIN_EMAIL=admin@autorecruit.local
PLATFORM_ADMIN_PASSWORD=admin1234

# AI sidecar shared secret — keep in sync between web and ai services
AI_SERVICE_SECRET=change-me-ai-service-secret

# LLM providers — optional, app works without them (stub heuristic fallback)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
